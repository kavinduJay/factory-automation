# Copy to .env and change every password. .env is not committed.

# Database (TimescaleDB). Also used by Grafana's datasource.
DB_PASSWORD=change-me-db

# EMQX web dashboard (http://localhost:18083), user "admin".
EMQX_DASHBOARD_PASSWORD=change-me-emqx

# Dashboard login. The admin user is created on first start if no users exist.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin
# Signs login tokens. Use a long random string: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string

# Caddy. Laptop: ":80" (plain HTTP on HTTP_PORT).
# VPS: your domain, e.g. "tf01.example.com", with HTTP_PORT=80 and HTTPS_PORT=443
# for automatic HTTPS.
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443

# MQTT 1883 is bound to localhost by default. To let a bench ESP32 on the
# same Wi-Fi reach the laptop, set MQTT_BIND=0.0.0.0 (dev network only).
MQTT_BIND=127.0.0.1

# Seconds between offline checks.
OFFLINE_CHECK_S=15

# Simulator (only with --profile sim)
# SIM_SPEED: process clock multiplier. 60 means an 8 h wither takes 8 min.
# Telemetry rate follows each node's poll_s setting (10 s; ambient 30 s).
SIM_SPEED=60
# 1 = inject faults now and then (hot fermentation, fan trip, over-limit crate,
# a node going offline, duplicate messages). 0 = clean data.
SIM_FAULTS=1

# Grafana (only with --profile grafana), http://localhost:3000, user "admin"
GRAFANA_PASSWORD=change-me-grafana

LOG_LEVEL=INFO
